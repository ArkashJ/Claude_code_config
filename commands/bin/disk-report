#!/usr/bin/env bash
# usage: disk-report | --self-test
# One screen, read-only: df /, /tmp/gocache-* sizes, ~/Library/Caches/go-build, ~/go/pkg/mod, colima
# (`colima list`, if installed), `docker system df` (only if the daemon answers within 5s), and every
# */.claude/worktrees dir under ~/Developer with its size. Deletes nothing: see gocache-sweep.
set -euo pipefail
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }
DEV=${DISK_REPORT_DEV:-$HOME/Developer}

# du in KiB -> "1.2G" style, one path per line "<size>\t<path>"; missing paths are skipped
sizes() { local p; for p in "$@"; do [ -e "$p" ] && du -sh "$p" 2>/dev/null || true; done; }

section() { printf '\n== %s ==\n' "$1"; }

report() {
  section "df /"
  df -h / | awk 'NR == 1 || NR == 2'
  section "/tmp/gocache-*"
  # shellcheck disable=SC2046 # one path per word is the point; the glob may match nothing
  sizes $(compgen -G "${DISK_REPORT_TMP:-/tmp}/gocache-*" || true)
  section "go caches"
  sizes "$HOME/Library/Caches/go-build" "$HOME/go/pkg/mod"
  section "colima"
  if command -v colima >/dev/null 2>&1; then colima list 2>&1 || true; else echo "(colima not installed)"; fi
  section "docker system df"
  if command -v docker >/dev/null 2>&1 && timeout 5 docker info >/dev/null 2>&1; then
    timeout 5 docker system df 2>&1 || echo "(docker system df timed out)"
  else
    echo "(skipped: docker missing or daemon did not answer within 5s)"
  fi
  section "worktrees under $DEV"
  local d n=0
  while IFS= read -r d; do
    n=$((n + 1))
    sizes "$d"
  done < <(find "$DEV" -maxdepth 5 -type d -path '*/.claude/worktrees/*' 2>/dev/null | grep -E '/\.claude/worktrees/[^/]+$' || true)
  echo "($n worktree dirs)"
}

self_test() {
  [[ $("$0" -h) == usage:* ]] || { echo "SELF-TEST FAIL: -h does not print usage" >&2; exit 1; }
  local d out
  d=$(mktemp -d /tmp/disk-report-selftest.XXXXXX)
  mkdir -p "$d/tmp/gocache-a" "$d/dev/p/.claude/worktrees/w1" "$d/dev/p/.claude/worktrees/w2/sub"
  head -c 2097152 /dev/zero >"$d/tmp/gocache-a/blob"
  out=$(DISK_REPORT_TMP="$d/tmp" DISK_REPORT_DEV="$d/dev" "$0")
  for want in '== df /' 'gocache-a' '== colima' '== docker system df' '(2 worktree dirs)'; do
    grep -qF -- "$want" <<<"$out" || { echo "SELF-TEST FAIL: output lacks '$want'" >&2; exit 1; }
  done
  rm -rf -- "${d:?}"
  echo "disk-report self-test: ok"
}

case ${1:-} in
  -h|--help) usage ;;
  --self-test) self_test ;;
  "") report ;;
  *) echo "unknown arg: $1 (try -h)" >&2; exit 2 ;;
esac
