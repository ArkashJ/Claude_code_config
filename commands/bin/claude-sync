#!/bin/sh
# One command to move Claude Code config between machines.
#
#   claude-sync         regenerate derived surfaces, commit, push ~/.claude
#   claude-sync pull    fast-forward this machine from the remote
#   claude-sync adopt   turn an EXISTING, un-cloned ~/.claude into a checkout of the
#                       remote, keeping this machine's runtime state and settings.json
#
# Bootstrap on a new machine (no clone needed, and works on a ~/.claude that is
# already full of local config -- adopt backs up whatever it would overwrite):
#   curl -fsSL https://raw.githubusercontent.com/ArkashJ/Claude_code_config/main/commands/bin/claude-sync | sh -s adopt
set -eu

CFG="$HOME/.claude"
SITE="${SITE:-$HOME/Developer/personal/Personal-Website}"

case "${1:-push}" in
  pull)
    # --autostash: uncommitted local edits ride along instead of blocking the pull.
    git -C "$CFG" pull -q --rebase --autostash
    sh "$CFG/commands/bin/link-skills.sh" >/dev/null || echo "claude-sync: link-skills failed (skills may be duplicated)" >&2
    exit 0
    ;;
  adopt)
    # Everything in ~/.claude that is not on the allowlist in .gitignore is runtime state
    # (transcripts, caches, session locks) and is invisible to git, so it survives this
    # untouched. Only TRACKED paths get overwritten -- back those up first, because on a
    # machine that already had config they are the hand-written ones.
    # SSH when a key works, else read-only HTTPS -- a fresh machine usually has no key yet.
    if [ -z "${REMOTE:-}" ]; then
      REMOTE=git@github.com:ArkashJ/Claude_code_config.git
      GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=5" git ls-remote "$REMOTE" >/dev/null 2>&1 ||
        REMOTE=https://github.com/ArkashJ/Claude_code_config.git
    fi
    BAK="$HOME/claude-config-backup-$(date '+%Y%m%d-%H%M%S')"
    if [ -d "$CFG/.git" ]; then
      echo "claude-sync: $CFG is already a git repo -- use 'claude-sync pull'" >&2
      exit 2
    fi
    mkdir -p "$CFG"
    git -C "$CFG" init -q
    git -C "$CFG" remote add origin "$REMOTE"
    git -C "$CFG" fetch -q origin
    # `|| true`: the loop's exit status is the last -e test, and under `set -e` a final
    # missing path would abort the whole adopt before it started.
    clobber=$(git -C "$CFG" ls-tree -r --name-only origin/main |
              while read -r f; do [ -e "$CFG/$f" ] && printf '%s\n' "$f"; done || true)
    if [ -n "$clobber" ]; then
      mkdir -p "$BAK"
      printf '%s\n' "$clobber" | tar -C "$CFG" -cf - -T - | tar -C "$BAK" -xf -
      echo "adopt:  backed up $(printf '%s\n' "$clobber" | wc -l | tr -d ' ') existing file(s) -> $BAK"
    fi
    git -C "$CFG" checkout -f -B main origin/main >/dev/null 2>&1
    if [ ! -f "$CFG/settings.json" ] && [ -f "$CFG/settings.example.json" ]; then
      cp "$CFG/settings.example.json" "$CFG/settings.json"
      chmod 600 "$CFG/settings.json"
      echo "adopt:  settings.json created from the example -- fill in <AWS_ACCOUNT_ID>"
    fi
    mkdir -p "$HOME/.local/bin"
    ln -sf "$CFG/commands/bin/claude-sync" "$HOME/.local/bin/claude-sync"
    echo "adopt:  linked ~/.local/bin/claude-sync"
    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "adopt:  add ~/.local/bin to PATH" ;; esac
    # plugins/ ships manifests only; reinstall from them when the claude CLI is present.
    if command -v claude >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
      python3 - "$CFG/plugins" <<'PY' |
import json, sys
d = sys.argv[1]
for m in json.load(open(d + "/known_marketplaces.json")).values():
    if m.get("source", {}).get("repo"): print("marketplace", m["source"]["repo"])
for p in json.load(open(d + "/installed_plugins.json")).get("plugins", {}):
    print("plugin", p)
PY
      while read -r kind arg; do
        if [ "$kind" = marketplace ]; then
          claude plugin marketplace add "$arg" >/dev/null 2>&1 || true
        elif claude plugin install "$arg" >/dev/null 2>&1; then
          echo "adopt:  plugin $arg"
        else
          echo "adopt:  plugin $arg FAILED -- retry: claude plugin install $arg"
        fi
      done
    fi
    sh "$CFG/commands/bin/link-skills.sh" || echo "adopt:  link-skills failed" >&2
    echo "adopt:  $CFG now tracks $REMOTE at $(git -C "$CFG" rev-parse --short HEAD)"
    exit 0
    ;;
  push) ;;
  *)
    echo "usage: claude-sync [push|pull|adopt]" >&2
    exit 2
    ;;
esac

# --- derived surfaces (each is best-effort; a missing target must not block the push)

# Skills that other agents load live in ~/.agents, outside the repo. The lock file
# records where each came from, so a fresh machine can reinstall them.
if [ -f "$HOME/.agents/.skill-lock.json" ]; then
  cp "$HOME/.agents/.skill-lock.json" "$CFG/agents-skill-lock.json"
fi

# settings.json is untracked (real AWS account id in the autoMode policy, public repo).
# Publish a redacted copy so the settings still travel. Validate before writing, so a
# broken redaction can never be the thing a new machine bootstraps from.
if [ -f "$CFG/settings.json" ]; then
  tmp=$(mktemp)
  # Match the shape, not the literal — hardcoding the id here would republish the very
  # thing being redacted. AWS account ids are always exactly 12 digits.
  # $HOME -> ~ so hook paths resolve for any user on any machine.
  sed -E -e 's/[0-9]{12}/<AWS_ACCOUNT_ID>/g' -e "s#$HOME/#~/#g" "$CFG/settings.json" > "$tmp"
  # autoMode describes whichever client repo this machine last set it up for (org names,
  # prod domains) -- never publish it. Parsing here doubles as the validity check.
  if python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); d.pop("autoMode",None); json.dump(d,open(sys.argv[1],"w"),indent=2)' "$tmp" 2>/dev/null; then
    mv "$tmp" "$CFG/settings.example.json"
  else
    rm -f "$tmp"
    echo "claude-sync: redacted settings failed to parse — settings.example.json left as-is" >&2
  fi
fi

if [ -d "$HOME/.codex/prompts" ]; then
  sh "$CFG/commands/.codex/sync.sh" >/dev/null
fi

# One real copy per skill, the other agent links to it (see link-skills.sh for the incident).
sh "$CFG/commands/bin/link-skills.sh" || echo "claude-sync: link-skills failed (skills may be duplicated)" >&2

# --- push ~/.claude

# Take the other machines' changes first so the push is never rejected.
git -C "$CFG" pull -q --rebase --autostash ||
  { echo "claude-sync: pull failed -- resolve in $CFG, then rerun" >&2; exit 1; }
git -C "$CFG" add -A
if git -C "$CFG" diff --cached --quiet; then
  echo "config: already in sync"
else
  git -C "$CFG" commit -q -m "sync: $(date '+%Y-%m-%d %H:%M')"
  git -C "$CFG" push -q
  echo "config: pushed $(git -C "$CFG" rev-parse --short HEAD)"
fi

# --- publish commands to arkashj.com/skills

[ -d "$SITE/content/skills" ] || exit 0
sh "$CFG/commands/bin/sync-skills.sh" >/dev/null

# --porcelain, not `diff`: a brand-new command lands as an untracked file, which
# `git diff` does not report.
n=$(git -C "$SITE" status --porcelain -- content/skills | wc -l | tr -d ' ')
if [ "$n" = "0" ]; then
  echo "site:   /skills already current"
else
  git -C "$SITE" add content/skills
  git -C "$SITE" commit -q -m "skills: sync $n command(s) from ~/.claude/commands"
  git -C "$SITE" push -q
  echo "site:   published $n skill file(s) -> arkashj.com/skills"
fi
