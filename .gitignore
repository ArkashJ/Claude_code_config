# ~/.claude is mostly runtime state (transcripts, caches, session locks).
# Ignore everything at the root, then opt the portable config back in.
/*

!/.gitignore
!/README.md
!/CLAUDE.md
!/agents-skill-lock.json

# settings.json holds the real AWS account id in its autoMode policy, and this repo is
# public. claude-sync publishes a redacted settings.example.json in its place; autoMode is
# only honored from ~/.claude/settings.json itself, so the live file must stay untracked.
/settings.json
!/settings.example.json

!/commands/
!/rules/
!/skills/

# plugins/ is a large install tree; only the manifests are portable.
!/plugins/
/plugins/*
!/plugins/*.json

# Machine-local overrides and secrets never sync.
settings.local.json
*.local.json
.DS_Store
*.doctor-bak
*.doctor-backup-*
